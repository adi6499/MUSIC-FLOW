{
  "appId": "com.musicflow.app",
  "appName": "MusicFlow",
  "webDir": "web-app",
  "android": {
    "backgroundColor": "#08080A",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#08080A",
    "handleApplicationURL": true
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["*"],
    "cleartext": true
  },
  "plugins": {}
}
