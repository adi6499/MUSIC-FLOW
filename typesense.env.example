# ==============================================================================
# MUSICFLOW — TYPESENSE ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Master / Admin API key (Used ONLY by server.js / backend indexer, NEVER in client)
TYPESENSE_ADMIN_KEY=your_typesense_admin_key_here

# Restricted Search-Only API key (Read-only search credentials for Web/Android clients)
TYPESENSE_SEARCH_ONLY_KEY=your_typesense_search_only_key_here

# Network host & port configuration
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_DATA_DIR=./typesense-data
